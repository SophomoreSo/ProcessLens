# Copy to .env and adjust. All variables are optional.

# Network binding. Keep the default loopback address: ProcessLens has no
# authentication and must not be reachable from other machines.
PROCESSLENS_HOST=127.0.0.1
PROCESSLENS_PORT=8000
# Host headers accepted (DNS-rebinding protection), comma separated.
PROCESSLENS_ALLOWED_HOSTS=127.0.0.1,localhost

# Secret used to derive the CSRF token. If empty, a random key is generated at
# start-up (open pages then need a reload after a restart).
PROCESSLENS_SECRET_KEY=

# Storage. Default: ./data/processlens.db (SQLite) and ./data/uploads.
PROCESSLENS_DATA_DIR=./data
# Any SQLAlchemy URL, e.g. postgresql+psycopg://user:pass@localhost/processlens
# (requires `pip install "psycopg[binary]"`; not covered by the test suite).
PROCESSLENS_DATABASE_URL=

# Limits
PROCESSLENS_MAX_UPLOAD_MB=200
PROCESSLENS_MAX_ROWS=1000000
PROCESSLENS_MAX_COLUMNS=200
PROCESSLENS_MAX_FIELD_CHARS=2000
PROCESSLENS_MAX_FINDINGS_STORED=100000

# Analytics cache (entries) and logging
PROCESSLENS_CACHE_MAX_ENTRIES=256
PROCESSLENS_LOG_LEVEL=INFO
