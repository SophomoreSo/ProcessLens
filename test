def repolish(widget):
    """Re-apply the stylesheet after a dynamic property change."""
    widget.style().unpolish(widget)
    widget.style().polish(widget)
    widget.update()


def clamp(x):
    return max(0.0, min(1.0, x))


def ease_out_back(x):
    c1 = 1.70158
    c3 = c1 + 1
    return 1 + c3 * (x - 1) ** 3 + c1 * (x - 1) ** 2


def ease_out_cubic(x):
    return 1 - (1 - x) ** 3


class Status(Enum):
    PENDING = "pending"
    RUNNING = "running"
    PASSED = "passed"
    SKIPPED = "skipped"
    FAILED = "failed"


# ---------------------------------------------------------------------------
# Animated step indicator
# ---------------------------------------------------------------------------
class StepIndicator(QWidget):
    DOT_COUNT = 8
    SPIN_INTERVAL_MS = 110
    FINISH_DURATION_MS = 700

    FILL = {
        Status.PASSED: QColor("#16A34A"),
        Status.SKIPPED: QColor("#F59E0B"),
        Status.FAILED: QColor("#DC2626"),
    }
    SPINNER_COLOR = QColor("#2563EB")

    def __init__(self, number, parent=None):
        super().__init__(parent)
        self.setFixedSize(36, 36)
        self.number = number
        self.state = Status.PENDING

        # Loading dots
        self._spin_step = 0
        self._spin_timer = QTimer(self)
        self._spin_timer.setInterval(self.SPIN_INTERVAL_MS)
        self._spin_timer.timeout.connect(self._advance_spinner)

        # Finish animation (badge pop + mark drawing)
        self._progress = 1.0
        self._anim = QVariantAnimation(self)
        self._anim.setStartValue(0.0)
        self._anim.setEndValue(1.0)
        self._anim.setDuration(self.FINISH_DURATION_MS)
        self._anim.valueChanged.connect(self._on_anim_value)

    def set_state(self, state):
        self.state = state
        self._anim.stop()

        if state is Status.RUNNING:
            self._spin_step = 0
            self._spin_timer.start()
        else:
            self._spin_timer.stop()

        if state in self.FILL:
            self._progress = 0.0
            self._anim.start()
        else:
            self._progress = 1.0
        self.update()

    def _advance_spinner(self):
        self._spin_step = (self._spin_step + 1) % self.DOT_COUNT
        self.update()

    def _on_anim_value(self, value):
        self._progress = float(value)
        self.update()

    # --- painting ---------------------------------------------------------
    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        rect = QRectF(self.rect()).adjusted(2, 2, -2, -2)
        center = rect.center()
        radius = rect.width() / 2

        if self.state is Status.PENDING:
            self._paint_pending(p, rect, center, radius)
        elif self.state is Status.RUNNING:
            self._paint_spinner(p, center, radius)
        else:
            self._paint_finished(p, rect, center, radius)
        p.end()

    def _paint_pending(self, p, rect, center, radius):
        p.setPen(QPen(QColor("#D5DBE5"), 1.5))
        p.setBrush(QColor("#F3F5F9"))
        p.drawEllipse(center, radius, radius)

        font = QFont(self.font())
        font.setBold(True)
        font.setPointSizeF(10.5)
        p.setFont(font)
        p.setPen(QColor("#6B7280"))
        p.drawText(rect, Qt.AlignCenter, str(self.number))

    def _paint_spinner(self, p, center, radius):
        p.setPen(Qt.NoPen)
        ring = radius * 0.62
        dot = radius * 0.15
        n = self.DOT_COUNT
        for i in range(n):
            angle = -math.pi / 2 + 2 * math.pi * i / n
            age = (self._spin_step - i) % n           # 0 = leading dot
            fade = age / n
            color = QColor(self.SPINNER_COLOR)
            color.setAlphaF(1.0 - fade * 0.85)
            size = dot * (1.0 - fade * 0.4)
            pos = QPointF(center.x() + math.cos(angle) * ring,
                          center.y() + math.sin(angle) * ring)
            p.setBrush(color)
            p.drawEllipse(pos, size, size)

    def _paint_finished(self, p, rect, center, radius):
        t = self._progress
        circle_t = ease_out_back(clamp(t / 0.45)) if t < 0.45 else 1.0
        mark_t = ease_out_cubic(clamp((t - 0.35) / 0.65))

        p.setPen(Qt.NoPen)
        p.setBrush(self.FILL[self.state])
        r = radius * max(0.0, circle_t)
        p.drawEllipse(center, r, r)

        if mark_t <= 0:
            return

        pen = QPen(QColor("#FFFFFF"), 2.6)
        pen.setCapStyle(Qt.RoundCap)
        pen.setJoinStyle(Qt.RoundJoin)
        p.setPen(pen)
        p.setBrush(Qt.NoBrush)

        def pt(fx, fy):
            return QPointF(rect.left() + fx * rect.width(),
                           rect.top() + fy * rect.height())

        if self.state is Status.FAILED:
            self._draw_partial(p, [pt(0.35, 0.35), pt(0.65, 0.65)], clamp(mark_t * 2))
            self._draw_partial(p, [pt(0.65, 0.35), pt(0.35, 0.65)], clamp(mark_t * 2 - 1))
        else:
            self._draw_partial(p, [pt(0.28, 0.52), pt(0.44, 0.67), pt(0.73, 0.36)], mark_t)

    @staticmethod
    def _draw_partial(p, points, t):
        """Draw a polyline up to fraction t of its total length."""
        if t <= 0:
            return
        segments = list(zip(points, points[1:]))
        lengths = [math.hypot(b.x() - a.x(), b.y() - a.y()) for a, b in segments]
        remaining = sum(lengths) * t
        path = QPainterPath(points[0])
        for (a, b), length in zip(segments, lengths):
            if remaining <= 0:
                break
            f = min(1.0, remaining / length)
            path.lineTo(a + (b - a) * f)
            remaining -= length
        p.drawPath(path)


# ---------------------------------------------------------------------------
class TaskWorker(QThread):
    result = pyqtSignal(bool, str)

    def __init__(self, func, parent=None):
        super().__init__(parent)
        self.func = func

    def run(self):
        try:
            ok, msg = self.func()
        except Exception as exc:
            ok, msg = False, f"Error: {exc}"
        self.result.emit(bool(ok), str(msg))


class StepRow(QFrame):
    status_changed = pyqtSignal()

    def __init__(self, index, title, description, task, parent=None):
        super().__init__(parent)
        self.setObjectName("StepRow")
        self.title = title
        self.description = description
        self.task = task
        self.worker = None
        self.status = Status.PENDING

        shadow = QGraphicsDropShadowEffect(self)
        shadow.setBlurRadius(18)
        shadow.setOffset(0, 2)
        shadow.setColor(QColor(15, 23, 42, 20))
        self.setGraphicsEffect(shadow)

        self.indicator = StepIndicator(index)

        self.title_lbl = QLabel(title)
        self.title_lbl.setObjectName("StepTitle")
        self.status_lbl = QLabel(description)
        self.status_lbl.setObjectName("StepStatus")

        text_col = QVBoxLayout()
        text_col.setSpacing(2)
        text_col.addWidget(self.title_lbl)
        text_col.addWidget(self.status_lbl)

        self.go_btn = QPushButton("GO")
        self.go_btn.setObjectName("GoButton")
        self.go_btn.setFixedWidth(90)
        self.go_btn.setCursor(Qt.PointingHandCursor)
        self.go_btn.clicked.connect(self.run_task)

        self.skip_btn = QPushButton("Skip")
        self.skip_btn.setObjectName("SkipButton")
        self.skip_btn.setFixedWidth(80)
        self.skip_btn.setCursor(Qt.PointingHandCursor)
        self.skip_btn.clicked.connect(self.skip)

        layout = QHBoxLayout(self)
        layout.setContentsMargins(16, 14, 16, 14)
        layout.setSpacing(14)
        layout.addWidget(self.indicator)
        layout.addLayout(text_col, 1)
        layout.addWidget(self.go_btn)
        layout.addWidget(self.skip_btn)

        self._set_status(Status.PENDING, description)

    # --- public API -------------------------------------------------------
    def is_complete(self):
        return self.status in (Status.PASSED, Status.SKIPPED)

    def is_running(self):
        return self.status is Status.RUNNING

    def run_task(self):
        if self.worker and self.worker.isRunning():
            return
        self._set_status(Status.RUNNING, "Running…")
        self.worker = TaskWorker(self.task, self)
        self.worker.result.connect(self._on_result)
        self.worker.start()

    def skip(self):
        self._set_status(Status.SKIPPED, "Skipped by user")

    def reset(self):
        self._set_status(Status.PENDING, self.description)

    # --- internals --------------------------------------------------------
    def _on_result(self, ok, msg):
        self._set_status(Status.PASSED if ok else Status.FAILED, msg)

    def _set_status(self, status, message):
        self.status = status
        for w in (self, self.status_lbl):
            w.setProperty("status", status.value)
            repolish(w)
        self.status_lbl.setText(message)
        self.indicator.set_state(status)

        self.go_btn.setText("Retry" if status is Status.FAILED else "GO")
        actionable = status in (Status.PENDING, Status.FAILED)
        self.go_btn.setEnabled(actionable)
        self.skip_btn.setEnabled(actionable)
        self.status_changed.emit()


class MainWindow(QWidget):
    def __init__(self):
        super().__init__()
        self.setObjectName("Root")
        self.setAttribute(Qt.WA_StyledBackground, True)
        self.setWindowTitle("System Readiness Check")
        self.setMinimumWidth(640)

        title = QLabel("System Readiness Check")
        title.setObjectName("HeaderTitle")
        subtitle = QLabel("Run or skip each requirement below to enable Start.")
        subtitle.setObjectName("HeaderSubtitle")

        self.rows = [
            StepRow(1, "Connect EnPortal",
                    "Establish a session with EnPortal", connect_enportal),
            StepRow(2, "Connect GateOne",
                    "Establish a session with GateOne", connect_gateone),
            StepRow(3, "Check DB connection",
                    "Verify the database is reachable", check_db_connection),
        ]

        rows_layout = QVBoxLayout()
        rows_layout.setSpacing(12)
        for row in self.rows:
            row.status_changed.connect(self.update_state)
            rows_layout.addWidget(row)

        divider = QFrame()
        divider.setObjectName("Divider")
        divider.setFixedHeight(1)

        self.progress = QProgressBar()
        self.progress.setRange(0, len(self.rows))
        self.progress.setTextVisible(False)
        self.progress.setFixedHeight(6)

        self.progress_lbl = QLabel()
        self.progress_lbl.setObjectName("ProgressLabel")

        progress_col = QVBoxLayout()
        progress_col.setSpacing(6)
        progress_col.addWidget(self.progress_lbl)
        progress_col.addWidget(self.progress)

        self.reset_btn = QPushButton("Reset")
        self.reset_btn.setObjectName("ResetButton")
        self.reset_btn.setCursor(Qt.PointingHandCursor)
        self.reset_btn.clicked.connect(self.reset_all)

        self.start_btn = QPushButton("Start")
        self.start_btn.setObjectName("StartButton")
        self.start_btn.setCursor(Qt.PointingHandCursor)
        self.start_btn.clicked.connect(self.start_process)

        footer = QHBoxLayout()
        footer.setSpacing(12)
        footer.addLayout(progress_col, 1)
        footer.addSpacing(20)
        footer.addWidget(self.reset_btn)
        footer.addWidget(self.start_btn)

        root = QVBoxLayout(self)
        root.setContentsMargins(28, 24, 28, 24)
        root.setSpacing(6)
        root.addWidget(title)
        root.addWidget(subtitle)
        root.addSpacing(16)
        root.addLayout(rows_layout)
        root.addSpacing(18)
        root.addWidget(divider)
        root.addSpacing(14)
        root.addLayout(footer)

        self.update_state()

    def update_state(self):
        total = len(self.rows)
        done = sum(r.is_complete() for r in self.rows)
        busy = any(r.is_running() for r in self.rows)

        self.progress.setValue(done)
        self.progress_lbl.setText(f"{done} of {total} requirements met")
        self.start_btn.setEnabled(done == total)
        self.reset_btn.setEnabled(
            not busy and any(r.status is not Status.PENDING for r in self.rows)
        )

    def reset_all(self):
        for row in self.rows:
            row.reset()

    def start_process(self):
        # Replace with your real start logic.
        skipped = [r.title for r in self.rows if r.status is Status.SKIPPED]
        msg = "All requirements are met. Starting process…"
        if skipped:
            msg += "\n\nSkipped: " + ", ".join(skipped)
        QMessageBox.information(self, "Start", msg)

    def closeEvent(self, event):
        for row in self.rows:
            if row.worker and row.worker.isRunning():
                row.worker.wait()
        super().closeEvent(event)


def main():
    QApplication.setAttribute(Qt.AA_EnableHighDpiScaling, True)
    QApplication.setAttribute(Qt.AA_UseHighDpiPixmaps, True)
    app = QApplication(sys.argv)
    app.setStyle("Fusion")
    app.setStyleSheet(STYLESHEET)

    window = MainWindow()
    window.show()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()